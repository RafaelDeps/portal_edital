# Telegram Config
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Plugins opcionais do portal (deixe vazio para manter desativado)
# UserWay (acessibilidade): Account ID fornecido pelo painel UserWay
PUBLIC_USERWAY_ACCOUNT_ID=
# Microsoft Clarity: Project ID fornecido pelo painel Clarity
PUBLIC_CLARITY_PROJECT_ID=
# Google Analytics 4 (GA4): Measurement ID no formato G-XXXXXXXXXX
PUBLIC_GA_MEASUREMENT_ID=
