---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import EditalCard from "../../components/EditalCard.astro";
import { getCollection } from "astro:content";
import { parseLocalDate } from "../../utils/chamadas.js";

const allEditais = await getCollection("editais");

const encerrados = allEditais
    .filter((edital) => edital.data.status === "encerrado")
    .sort((a, b) => {
        const dateA = parseLocalDate(a.data.data_encerramento)?.getTime() ?? -Infinity;
        const dateB = parseLocalDate(b.data.data_encerramento)?.getTime() ?? -Infinity;
        if (dateB !== dateA) return dateB - dateA;
        return a.data.nome.localeCompare(b.data.nome, "pt-BR");
    });
---

<BaseLayout
    title="Editais Encerrados — Portal de Editais"
    description="Histórico completo de editais encerrados e arquivados no Portal de Editais."
>
    <Header />
    <main id="main-content" class="flex-grow py-8 sm:py-16" tabindex="-1">
        <div class="container">
            <section class="max-w-3xl mb-10">
                <div
                    class="inline-flex items-center space-x-2 bg-slate-500/10 border border-slate-500/20 rounded-full px-4 py-1.5 mb-6"
                >
                    <span class="flex h-2 w-2 rounded-full bg-slate-500"></span>
                    <span class="text-xs font-bold text-slate-600 dark:text-slate-300 uppercase tracking-widest">
                        Histórico
                    </span>
                </div>
                <h1 class="text-4xl sm:text-5xl font-black text-primary-900 dark:text-white mb-4 leading-tight">
                    Editais <span class="text-transparent bg-clip-text bg-gradient-to-r from-slate-600 to-cta-500 dark:from-slate-300 dark:to-cta-400">encerrados</span>
                </h1>
                <p class="text-lg text-primary-600 dark:text-primary-300">
                    Consulte o histórico de editais já finalizados e arquivados. Para ver oportunidades com inscrições abertas, acesse a{" "}
                    <a
                        href={import.meta.env.BASE_URL}
                        class="font-semibold text-cta-600 dark:text-cta-400 underline hover:no-underline"
                    >
                        página inicial
                    </a>.
                </p>
            </section>

            <section class="mb-8 flex flex-col sm:flex-row sm:items-end justify-between gap-4">
                <div class="w-full sm:max-w-md">
                    <label
                        for="encerrados-search"
                        class="block text-sm font-semibold text-primary-900 dark:text-white mb-1.5"
                    >
                        Buscar no histórico
                    </label>
                    <input
                        id="encerrados-search"
                        type="search"
                        data-testid="encerrados-search"
                        placeholder="Filtrar por nome, descrição ou órgão..."
                        class="w-full rounded-xl border border-primary-300 dark:border-primary-700 bg-white dark:bg-slate-900 px-4 py-2.5 text-sm text-primary-900 dark:text-white placeholder:text-primary-400 focus:outline-none focus-visible:ring-2 focus-visible:ring-cta-500"
                    />
                </div>
                <p
                    class="text-sm font-medium text-primary-600 dark:text-primary-400"
                    data-testid="encerrados-count"
                    aria-live="polite"
                >
                    {encerrados.length} {encerrados.length === 1 ? "edital encerrado" : "editais encerrados"}
                </p>
            </section>

            {
                encerrados.length > 0 ? (
                    <>
                        <div
                            id="encerrados-grid"
                            data-testid="encerrados-grid"
                            class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"
                        >
                            {encerrados.map((edital) => (
                                <EditalCard edital={edital} />
                            ))}
                        </div>
                        <p
                            id="encerrados-empty"
                            data-testid="encerrados-empty"
                            class="hidden text-center py-12 text-primary-600 dark:text-primary-400"
                        >
                            Nenhum edital encerrado encontrado para o termo informado.
                        </p>
                    </>
                ) : (
                    <p
                        data-testid="encerrados-empty"
                        class="text-center py-12 text-primary-600 dark:text-primary-400"
                    >
                        Nenhum edital encerrado registrado no momento.
                    </p>
                )
            }
        </div>
    </main>
    <Footer />
</BaseLayout>

<script is:inline>
    (function () {
        var input = document.getElementById("encerrados-search");
        var grid = document.getElementById("encerrados-grid");
        var countEl = document.querySelector("[data-testid='encerrados-count']");
        var emptyEl = document.getElementById("encerrados-empty");
        if (!input || !grid) return;

        var cards = Array.from(grid.querySelectorAll("[data-testid='edital-card']"));

        function filterCards() {
            var term = (input.value || "").trim().toLowerCase();
            var visible = 0;

            cards.forEach(function (card) {
                var hay = card.getAttribute("data-search-index") || "";
                var matches = !term || hay.indexOf(term) !== -1;
                card.classList.toggle("hidden", !matches);
                if (matches) visible += 1;
            });

            if (countEl) {
                countEl.textContent =
                    visible + (visible === 1 ? " edital encerrado" : " editais encerrados");
            }
            if (emptyEl) {
                emptyEl.classList.toggle("hidden", visible > 0);
            }
        }

        input.addEventListener("input", filterCards);
    })();
</script>
